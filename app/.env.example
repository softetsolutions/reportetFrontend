# ReportET React app — copy to .env for local, or set in Vercel for production.

# Production API (path must match nginx /api mount)
# VITE_REPORTET_BASE_URL=https://schoolet.org/schoolet

# Local API
VITE_REPORTET_BASE_URL=http://localhost:5005/api

# Marketing site (vanilla) — used for “back to site” / post-logout
VITE_MARKETING_URL=http://localhost:5500
# Production:
# VITE_MARKETING_URL=https://reportet.softetsolutions.com

# Mapbox (admin maps)
VITE_MAPBOX_TOKEN=
